# ==============================================================================
# 1. SOURCE API: Fetch active client desired job titles from ApplyUS CRM API
# ==============================================================================
CRM_BACKEND_URL=https://api.applyus.org
INTERNAL_SERVICE_API_KEY=your_internal_service_api_key_here

# Fallback: Source Database (Supabase)
SOURCE_SUPABASE_URL=https://your-supabase-project.supabase.co
SOURCE_SUPABASE_KEY=your_supabase_key
SOURCE_TABLE=onboarding_submissions

# ==============================================================================
# 2. DESTINATION DATABASE (NEON DB): Where scraped jobs / links are stored
# ==============================================================================
NEON_DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
NEON_TABLE=links

# ==============================================================================
# 3. SCRAPER CONFIGURATION
# ==============================================================================
MAX_JOBS=100
MAX_JOBS_PER_KEYWORD=100
MAX_KEYWORDS=5
ONLY_LAST_24_HOURS=true

# ==============================================================================
# 4. WEBSHARE ROTATING PROXY CONFIGURATION
# ==============================================================================
WEBSHARE_PROXY=http://username-rotate:password@p.webshare.io:80
WEBSHARE_PROXIES=http://username-rotate:password@p.webshare.io:80
